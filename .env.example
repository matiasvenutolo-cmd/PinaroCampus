# Ver docs/02-arquitectura.md para el detalle de cada variable.
# Copiá este archivo a .env.local y completá los valores reales (nunca comitear .env.local).

# Base de datos (Neon, vía Vercel Marketplace)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js (Fase 1)
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Email transaccional (Fase 1)
RESEND_API_KEY=
EMAIL_FROM="Campus <campus@pinaro.ar>"

# Archivos subidos: logos, firmas, PDFs de certificados (Fase 1+)
BLOB_READ_WRITE_TOKEN=

# Secretos propios
ENCRYPTION_KEY=
PREVIEW_SIGNING_SECRET=
CRON_SECRET=

# Multi-tenant
SUPERADMIN_HOSTS=localhost:3000,civa.localhost:3000,plataforma.pinaro.ar
PLATFORM_ROOT_DOMAIN=pinaro.ar
DEV_TENANT_OVERRIDE=
DEMO_MODE=true
SEED_SUPERADMIN_EMAIL=tu-email@ejemplo.com

# Mercado Pago (Fase 5)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_PLATFORM_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=true
